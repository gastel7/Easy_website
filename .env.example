# ---------------------------------------------------------------------------
# EASY — variables d'environnement
# Copiez ce fichier en « .env » à la racine du projet et remplissez-le.
# Le .env ne se commit JAMAIS (déjà ignoré par .gitignore).
# ---------------------------------------------------------------------------

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=changez-moi-avec-une-cle-longue-et-aleatoire
# 1 = développement, 0 = production (mis à 0 avant une mise en ligne)
DJANGO_DEBUG=1
# Hôtes acceptés, séparés par des virgules (ex : easy.cg,www.easy.cg)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Base SQLite utilisée (par défaut db.sqlite3)
DJANGO_DB_NAME=db.sqlite3

# --- Sécurité (valeurs automatiques si DJANGO_DEBUG=0) --------------------
# HTTPS forcé, cookies sécurisés et HSTS : passent à « 1 » dès que DEBUG=0.
# À mettre à « 0 » uniquement si le site est réellement servi en HTTP.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
# Durée du HSTS en secondes (0 = désactivé)
DJANGO_HSTS_SECONDS=31536000

# --- Connexion sociale (allauth) -----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Email ----------------------------------------------------------------
# Par défaut les mails s'affichent dans la console. En production : SMTP
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_TLS=1
DJANGO_FROM_EMAIL=EASY <no-reply@easy.cg>

# --- Paiement des billets — TamoAPI (https://tamo.tasa.pro) ---------------
# Clés du Dashboard Tamo → Clés API. AUCUNE de ces valeurs n'est versionnée
# ni envoyée au navigateur, sauf TAMO_API_TOKEN (clé publique du SDK Checkout).

# URL de base de l'API (Production)
TAMO_API_BASE=https://tamoapi.tasa.pro/api
# api_token (tok_…) : en-tête X-API-Token des lectures ET clé publique du SDK
TAMO_API_TOKEN=
# api_secret : signature HMAC-SHA256 « v2 » des écritures. Jamais exposé.
TAMO_API_SECRET=
# Secret du webhook (Dashboard → Produits → URL de rappel), propre à la destination
TAMO_WEBHOOK_SECRET=
# UUID du produit « Collecte » actif
TAMO_PRODUCT_ID=
# Devise du produit : XAF (Congo) ou XOF (Sénégal)
TAMO_DEVISE=XAF
# Chemin d'interrogation du statut (à ajuster si TASA le publie autrement)
TAMO_STATUT_PATH=/v1/collections/{identifiant}
# Portail de paiement TamoCheckout (SDK) : 1 pour afficher le bouton
TAMO_CHECKOUT=0
TAMO_CHECKOUT_SDK_URL=https://tamoapi.tasa.pro/sdk/tamo.js
# Nom du marchand affiché dans la popup TamoCheckout
TAMO_MARCHAND=EASY

# URL de rappel à déclarer côté Tamo (Dashboard → Produits → callback URL) :
#   https://VOTRE-DOMAINE/paiements/webhook/tamo/
# Le domaine doit être en https et l'IP de ce serveur déclarée chez TASA.
